# Copia este archivo a ".env" y ajusta los valores según tu entorno.

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos PostgreSQL ---
# En local (docker-compose.local.yml) el host es "localhost" o el nombre del servicio "postgres" si corres el backend también en Docker.
# En AWS EC2, si usas el docker-compose.yml de la raíz, el host es el nombre del servicio "postgres".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tasks_db
DB_USER=postgres
DB_PASSWORD=postgres

# --- Autenticación JWT ---
# IMPORTANTE: cambiar este valor por uno propio y secreto en producción.
JWT_SECRET=change_this_secret_before_deploying
JWT_EXPIRES_IN=1h

# --- CORS ---
# URL donde corre el frontend Angular
CORS_ORIGIN=http://localhost:4200

# --- Usuario sembrado por "npm run seed" ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
