# Configuración para docker-compose.yml (raíz del repo).
# Copia este archivo a ".env" en la raíz y ajusta los valores según el entorno.
#
# IMPORTANTE: los mismos 3 servicios (postgres, backend, frontend) sirven tanto para
# correr todo en tu máquina local como en una instancia EC2 de AWS. Lo único que cambia
# entre un entorno y otro son CORS_ORIGIN y API_URL (ver explicación abajo).

# --- PostgreSQL ---
DB_NAME=tasks_db
DB_USER=postgres
DB_PASSWORD=postgres

# --- Backend / JWT ---
# Cambia este secreto antes de desplegar en un entorno real.
JWT_SECRET=change_this_secret_before_deploying
JWT_EXPIRES_IN=1h
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!

# CORS_ORIGIN debe ser exactamente la URL desde la que el NAVEGADOR abre el frontend
# (sin barra final). El backend rechaza peticiones que no vengan de este origen.
#   Local (docker-compose en tu máquina):  http://localhost
#   AWS EC2 (instancia actual):             http://34.230.89.199
CORS_ORIGIN=http://34.230.89.199

# --- Frontend ---
# API_URL es la URL que el NAVEGADOR del usuario usa para llamar al backend.
# Se inyecta en tiempo de arranque del contenedor (no requiere reconstruir la imagen).
#   Local (docker-compose en tu máquina):  http://localhost:3000/api
#   AWS EC2 (instancia actual):             http://34.230.89.199:3000/api
API_URL=http://34.230.89.199:3000/api
